+    def hangup(self, timeout: float = 4.0):
+        """End the SIP dialog and confirm the remote teardown.
+
+        pjsua sends BYE asynchronously. Merely waiting a fixed half-second and
+        clearing local state can leave the remote client showing a failed call,
+        while the MCP reports success. Keep the Call alive until its
+        DISCONNECTED callback, then use the endpoint-wide fallback once.
+        """
         self._reg()
+        requested = self.call is not None
+        error = ""
         try:
             if self.call:
                 self.call.hangup(pj.CallOpParam(True))
-                time.sleep(0.5)
-        except Exception:
-            pass
+        except Exception as exc:
+            error = str(exc)
+            _dlog("hangup request failed: %s" % error)
+        deadline = time.time() + timeout
+        while requested and not self.disconnected and time.time() < deadline:
+            time.sleep(0.05)
+        forced = requested and not self.disconnected
+        if forced:
+            try:
+                self.ep.hangupAllCalls()
+            except Exception as exc:
+                error = error or str(exc)
+                _dlog("hangupAllCalls fallback failed: %s" % exc)
+            deadline = time.time() + 2.0
+            while not self.disconnected and time.time() < deadline:
+                time.sleep(0.05)
+        confirmed = not requested or self.disconnected
         self.connected = False
+        self.aud = None
+        result = {
+            "requested": requested, "confirmed": confirmed, "forced": forced,
+            "sipStatus": self.last_status_code, "sipReason": self.last_reason,
+            "sipState": self.last_state_text, "error": error,
+        }
+        _dlog("hangup_confirmed=%s forced=%s status=%s reason=%r error=%r"
+              % (confirmed, forced, self.last_status_code, self.last_reason, error))
+        return result
 
