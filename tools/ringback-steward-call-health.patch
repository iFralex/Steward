+    def media_health(self) -> dict:
+        """Snapshot both application liveness and RTP counters.
+
+        RTP counters alone cannot prove handset reachability when a SIP relay
+        terminates media, but they make the failure attributable after the fact.
+        """
+        health = {
+            "connected": self.connected,
+            "disconnected": self.disconnected,
+            "consecutiveSilence": self.consecutive_silence,
+            "silenceLimit": REMOTE_SILENCE_LIMIT,
+            "lastListen": self.last_listen_health,
+        }
+        try:
+            if self.call is not None and self.media_index is not None:
+                stat = self.call.getStreamStat(self.media_index).rtcp
+                health["rtp"] = {
+                    "rxPackets": int(stat.rxStat.pkt),
+                    "rxBytes": int(stat.rxStat.bytes),
+                    "rxLost": int(stat.rxStat.loss),
+                    "txPackets": int(stat.txStat.pkt),
+                    "txBytes": int(stat.txStat.bytes),
+                    "txLost": int(stat.txStat.loss),
+                    "rttMeanUsec": int(stat.rttUsec.mean),
+                }
+        except Exception as exc:
+            health["rtpError"] = str(exc)
+        return health
+
+    def remote_media_stalled(self) -> bool:
+        return (self.connected and not self.disconnected
+                and REMOTE_SILENCE_LIMIT > 0
+                and self.consecutive_silence >= REMOTE_SILENCE_LIMIT)
 
