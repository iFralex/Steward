{
  "name": "steward-monorepo",
  "private": true,
  "scripts": {
    "build:web-host": "npm run build -w @steward/web && npm run typecheck -w @steward/host",
    "icon:mac": "node apps/mac-launcher/scripts/make-icon.mjs",
    "launcher:mac": "swift run --package-path apps/mac-launcher StewardLauncher",
    "package:mac": "node --import tsx apps/mac-launcher/package-mac.mts"
  },
  "workspaces": [
    "apps/host",
    "apps/web",
    "apps/mail-mcp",
    "apps/mail-mirror",
    "apps/mail-promoter",
    "apps/action-center",
    "apps/llm-gateway",
    "apps/calendar-mcp",
    "apps/contacts-mcp",
    "apps/shell-mcp",
    "apps/train-mcp",
    "apps/scheduler",
    "apps/wiki-add",
    "apps/llm-wiki",
    "packages/*"
  ]
}
