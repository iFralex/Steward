# Local, per-project overrides for apps/host. Copy to .env (gitignored) and edit.
# Anything already set in the real environment takes precedence over this file.
# Only variables actually read by the host process belong here — the gateway,
# mail-mirror/mail-promoter and scheduler each read their own env in their own
# process, so overriding e.g. GATEWAY_PORT or SCHED_*_MIN here has no effect.

# --- Network ---
# HOST_PORT=4317
# HOST_ALLOWED_ORIGINS=
# STEWARD_TLS_CERT=
# STEWARD_TLS_KEY=
# STEWARD_TLS_PORT=

# --- Auth ---
# STEWARD_AUTH_TOKEN=

# --- Agent / gateway ---
# HOST_SYSTEM_PROMPT=
# HOST_TIER=tier-5
# GATEWAY_BASE_URL=http://127.0.0.1:4000/v1
# GATEWAY_API_KEY=sk-local
# APPROVAL_TIMEOUT_MS=300000

# --- Speech / Whisper transcription ---
# STEWARD_SPEECH_ENABLED=1
# STEWARD_WHISPER_BIN=
# STEWARD_WHISPER_MODEL=
# STEWARD_SPEECH_TIMEOUT_MS=120000
# STEWARD_AUDIO_CONVERT_TIMEOUT_MS=30000

# Whisper transcription language (ISO 639-1). The application fallback is English;
# set it explicitly to Italian for Italian dictation and station names.
STEWARD_SPEECH_LANGUAGE=it

# --- Voice channel ---
# First transport: Ringback MCP over SIP/Linphone. The launcher is kept outside
# the Steward bundle so pjproject/pjsua2's GPL distribution obligations remain
# isolated. Run tools/setup-ringback.sh, fill Ringback's voice.env, then enable:
# STEWARD_VOICE_TRANSPORT=ringback
# STEWARD_RINGBACK_LAUNCHER=/absolute/path/to/ringback/run_voice_mcp.sh
# Optional override. When absent, the opening follows the language selected in the PWA.
# STEWARD_VOICE_OPENING_LINE=Hi, this is Steward. How can I help?
# STEWARD_VOICE_PREFLIGHT_TIMEOUT_MS=10000
# Reserved for the future realtime media transport (not implemented yet):
# STEWARD_STREAMCORE_URL=http://127.0.0.1:8080

# --- Push notifications ---
# STEWARD_PUSH_CONTACT=mailto:you@example.com

# --- Storage locations ---
# CHATS_DIR=
# UPLOAD_DIR=
# HOST_STATIC_DIR=

# --- System-status display (reads only; do not drive real behavior) ---
# SCHED_LOG=
# STEWARD_APP_PATH= (or LLM_WIKI_APP_PATH)
# STEWARD_ROOT= (or LLM_WIKI_ROOT)
# STEWARD_BUNDLED_SERVICES=0 (or LLM_WIKI_BUNDLED_SERVICES)
# STEWARD_SCHEDULER=1 (or LLM_WIKI_SCHEDULER; "0" reports unknown instead of warning)
# STEWARD_NODE= (or LLM_WIKI_NODE; defaults to the running node binary)

# --- Advanced: MCP entry-point overrides (dev/packaging only, rarely needed) ---
# STEWARD_MCP_ENTRY=
# LLM_WIKI_MCP_ENTRY=
# MAIL_MCP_ENTRY=
# CALENDAR_MCP_ENTRY=
# CONTACTS_MCP_ENTRY=
# SHELL_MCP_ENTRY=
# ACTION_CENTER_MCP_ENTRY=
