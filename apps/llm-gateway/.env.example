# DeepSeek API key — backs capability tiers 2–6 (V4 Flash on 2–5, V4 Pro on 6).
# Get one at https://platform.deepseek.com. Required for the chat tiers.
DEEPSEEK_API_KEY=

# Optional: OpenRouter keys, only if you re-introduce free OpenRouter deployments
# as a tier in the gateway's tier map. Not used by the default DeepSeek-backed config.
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=

# --- Services repoint here. The gateway runs on :4000. ---
# mail-mirror embeddings + role classifier:
#   MAIL_EMBED_ENDPOINT=http://127.0.0.1:4000/v1/embeddings
#   MAIL_EMBED_MODEL=local-embed
#   MAIL_CLASSIFY_ENDPOINT=http://127.0.0.1:4000/v1/chat/completions
#   MAIL_CLASSIFY_MODEL=tier-2
# mail-promoter (classify + distil in one triage call):
#   MAIL_PROMOTER_LLM_ENDPOINT=http://127.0.0.1:4000
#   MAIL_PROMOTER_TRIAGE_MODEL=tier-5
# llm-wiki embeddings: point its embedding endpoint at
#   http://127.0.0.1:4000/v1/embeddings  (model: local-embed)
